# {{ cookiecutter.project_slug }}
# Git attributes for consistent handling across platforms

# Set default behavior to automatically normalize line endings
* text=auto

# OpenTofu/Terraform files
*.tf text eol=lf
*.tfvars text eol=lf
*.hcl text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.adoc text eol=lf


# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# JSON files
*.json text eol=lf

# Configuration files
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.pre-commit-config.yaml text eol=lf
.tflint.hcl text eol=lf
Taskfile.yml text eol=lf
Makefile text eol=lf

# License and legal files
LICENSE text eol=lf
NOTICE text eol=lf
COPYRIGHT text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.pyc binary
*.pdf binary
*.ez binary
*.bz2 binary
*.swp binary

# Archives
*.jar binary
*.tar binary
*.tgz binary

# Exclude files from export
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
.pre-commit-config.yaml export-ignore
examples/ export-ignore